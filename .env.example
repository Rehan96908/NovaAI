# ONTOKEN_API_KEY: API key dari app.ontoken.id
ONTOKEN_API_KEY="MY_ONTOKEN_API_KEY"

# GEMINI_API_KEY: Fallback AI model provider jika ON Token tidak tersedia
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# POSTGRES_URL: Connection string PostgreSQL (otomatis di Vercel Postgres / Neon / Cloud SQL)
POSTGRES_URL=""

# JWT_SECRET: Secret untuk autentikasi sesi pengguna
JWT_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
