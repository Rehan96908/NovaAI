# ═══ WAJIB ═══════════════════════════════════════════════════════════
# API key dari dashboard ON Token (https://app.ontoken.id).
# Key ini HANYA dipakai di server. Jangan dibagikan, jangan di-commit ke Git.
ONTOKEN_API_KEY=sk-ont-ISI_KEY_KAMU_DI_SINI

# ═══ OPSIONAL (nilai di bawah = default) ═════════════════════════════
ONTOKEN_BASE_URL=https://api.ontoken.id/v1
PORT=3000

# Rahasia penanda sesi login (minimal 32 karakter acak).
# Jika dikosongkan, dibuat otomatis & disimpan di data/.jwt_secret.
# WAJIB diisi manual bila di-deploy ke Vercel (di sana tidak ada disk permanen
# untuk menyimpan nilai otomatis).
# Buat sendiri:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ═══ HANYA DIPERLUKAN DI VERCEL (biarkan kosong untuk menjalankan di komputer/VPS) ═══
# Diisi OTOMATIS oleh Vercel begitu kamu menambahkan Storage → Postgres di dashboard
# proyekmu. Kalau variabel ini terisi, aplikasi otomatis memakai Postgres alih-alih
# file lokal (lihat lib/db.js). Untuk pengujian Postgres di komputar sendiri, isi
# manual dengan connection string Postgres biasa (mis. dari Neon/Supabase/lokal).
POSTGRES_URL=

# Model default untuk pengguna baru (harus ada di models.json)
DEFAULT_MODEL=claude-sonnet-5

# Batas pemakaian per pengguna — melindungi saldo ONT-mu dari penyalahgunaan
FREE_DAILY_MESSAGES=50
MAX_OUTPUT_TOKENS=4096
MAX_FILE_MB=5
STORAGE_LIMIT_MB=100

# Maksimal pendaftaran baru per jam dari satu alamat IP
REGISTER_PER_HOUR=5

# false = pendaftaran ditutup (hanya akun yang sudah ada yang bisa masuk)
ALLOW_REGISTRATION=true

# Isi true bila server berada di belakang reverse proxy / hosting
# (Nginx, Cloudflare, Railway, Render, dll.) supaya IP & HTTPS terbaca benar.
TRUST_PROXY=false

SESSION_DAYS=7
REQUEST_TIMEOUT_S=180
